rules_version = '2';

// El navegador nunca habla con Firestore: todo pasa por la API, cuyo Admin SDK
// no está sujeto a estas reglas. Por eso se deniega cualquier acceso directo.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
